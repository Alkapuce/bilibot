LLM_BASE_URL=http://xxx/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=180.0
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
CHUNK_CHARS=8000

BILIBOT_OUTPUT_DIR=data
TRANSCRIPT_LANGUAGE=zh

# ASR options.
# ASR_BACKEND: "auto" (detect, default), "whisper", "qwen3", or "gguf"
#   auto: gguf 可用 → gguf (ONNX+llama.cpp, 最快最省显存)
#         ≥6GB VRAM → qwen3 (HuggingFace BF16)
#         <6GB VRAM → whisper (faster-whisper)
# ASR_MODEL:
#   whisper: base/small/medium/large-v1/large-v2/large-v3/turbo/distil-large-v3
#   qwen3:  qwen3-asr-1.7b / qwen3-asr-0.6b
#   gguf:    qwen3-asr-1.7b, 或本地模型目录
ASR_BACKEND=auto
ASR_PRESET=auto
ASR_MODEL=
# GGUF 模型目录 (包含 ONNX encoder + GGUF decoder 文件)
ASR_GGUF_MODEL_DIR=
# llama.cpp DLL 目录 (默认自动搜索 PATH 或 _gguf_core/bin/)
ASR_GGUF_LLAMA_BIN=
ASR_DEVICE=
ASR_COMPUTE_TYPE=
ASR_TASK=transcribe
ASR_BEAM_SIZE=5
ASR_BATCH_SIZE=
ASR_VAD_FILTER=
ASR_VAD_MIN_SILENCE_MS=
ASR_CONDITION_ON_PREVIOUS_TEXT=
ASR_CPU_THREADS=0
ASR_NUM_WORKERS=1
ASR_DOWNLOAD_ROOT=
ASR_LOCAL_FILES_ONLY=false
ASR_HOTWORDS=
# 默认：zh 语言时自动使用简体中文引导提示词；设为空可关闭
ASR_INITIAL_PROMPT=

# Optional LLM subtitle cleanup before note generation.
SUBTITLE_POSTPROCESS=false
SUBTITLE_POSTPROCESS_BASE_URL=
SUBTITLE_POSTPROCESS_API_KEY=
SUBTITLE_POSTPROCESS_MODEL=
SUBTITLE_POSTPROCESS_TEMPERATURE=
SUBTITLE_POSTPROCESS_CHUNK_CHARS=6000
SUBTITLE_POSTPROCESS_STYLE=clean

# Download options.
DOWNLOAD_TIMEOUT=60.0
DOWNLOAD_CHUNK_SIZE=1048576
YT_DLP_FORMAT=bestaudio
YT_DLP_AUDIO_FORMAT=mp3
YT_DLP_AUDIO_QUALITY=5

# Optional Bilibili auth/cookies for restricted videos.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_COOKIE_FILE=
