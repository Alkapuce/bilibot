# GPT-5.5 note generation via any provider exposing the OpenAI Responses API.
LLM_MODEL=gpt-5.5
LLM_FALLBACK_MODELS=
LLM_MODEL_PROVIDERS=gpt-5.5=responses_provider
LLM_PROVIDER_RESPONSES_PROVIDER_WIRE_API=responses
# Provider endpoint/key are local deployment settings; keep real values out of git.
LLM_PROVIDER_RESPONSES_PROVIDER_BASE_URL=https://your-endpoint.example/v1
LLM_PROVIDER_RESPONSES_PROVIDER_API_KEY=
# Default Chat Completions provider for non-Responses models.
LLM_BASE_URL=http://localhost:5001/v1
LLM_API_KEY=
LLM_TIMEOUT=180.0
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2.0
LLM_RETRY_MAX_DELAY=20.0
CHUNK_CHARS=200000
# Cap summarize calls to improve long-video stability; 0 disables this cap.
SUMMARY_MAX_SINGLE_CHUNK_CHARS=60000

BILIBOT_OUTPUT_DIR=data
TRANSCRIPT_LANGUAGE=zh

# ASR options.
# ASR_BACKEND: "auto" (detect, default), "whisper", "qwen3", or "gguf"
#   auto: ≥6GB VRAM → qwen3 (HuggingFace BF16 / safetensors)
#         GGUF configured and qwen3 unavailable → gguf
#         otherwise → whisper (faster-whisper)
# ASR_MODEL:
#   whisper: base/small/medium/large-v1/large-v2/large-v3/turbo/distil-large-v3
#   qwen3:  qwen3-asr-1.7b / qwen3-asr-0.6b
# Qwen3 ForcedAligner (optional; enables word/character timestamps for qwen3)
# ASR_FORCED_ALIGNER_MODEL=.models/Qwen3-ForcedAligner-0.6B
# ASR_RETURN_TIME_STAMPS=false
#   gguf:   local GGUF model directory
ASR_BACKEND=auto
ASR_PRESET=auto
ASR_MODEL=
# GGUF 模型目录：
# - 官方 llama.cpp 布局：*.gguf + mmproj-*.gguf
# - 旧版布局：ONNX encoder + GGUF decoder
ASR_GGUF_MODEL_DIR=
# llama.cpp multimodal CLI for official GGUF+mmproj models
ASR_GGUF_CLI=llama-mtmd-cli
# Legacy llama.cpp lib directory for old ONNX+GGUF layout
ASR_GGUF_LLAMA_BIN=
ASR_DEVICE=
ASR_COMPUTE_TYPE=
ASR_TASK=transcribe
ASR_BEAM_SIZE=5
ASR_BATCH_SIZE=
ASR_VAD_FILTER=
ASR_VAD_MIN_SILENCE_MS=
ASR_CONDITION_ON_PREVIOUS_TEXT=
ASR_CPU_THREADS=0
ASR_NUM_WORKERS=1
ASR_DOWNLOAD_ROOT=
ASR_LOCAL_FILES_ONLY=false
ASR_HOTWORDS=
# 默认：zh 语言时自动使用简体中文引导提示词；设为空可关闭
ASR_INITIAL_PROMPT=

# Optional LLM subtitle cleanup before note generation.
SUBTITLE_POSTPROCESS=false
SUBTITLE_POSTPROCESS_BASE_URL=
SUBTITLE_POSTPROCESS_API_KEY=
SUBTITLE_POSTPROCESS_MODEL=
SUBTITLE_POSTPROCESS_TEMPERATURE=
SUBTITLE_POSTPROCESS_CHUNK_CHARS=6000
SUBTITLE_POSTPROCESS_STYLE=clean

# Download options.
DOWNLOAD_TIMEOUT=60.0
DOWNLOAD_CHUNK_SIZE=1048576
YT_DLP_FORMAT=bestaudio
YT_DLP_AUDIO_FORMAT=mp3
YT_DLP_AUDIO_QUALITY=5

# Optional Bilibili auth/cookies for restricted videos.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_COOKIE_FILE=
